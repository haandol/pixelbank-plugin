{
  "name": "Pixelbank Plugin (Node 24)",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/pixelbank-plugin,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/pixelbank-plugin",
  "remoteUser": "node",
  "postCreateCommand": "npm ci --ignore-scripts",
  "shutdownAction": "stopContainer"
}
