{
  "name": "PixelbankStudio Plugin (Bun)",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/pixelbank-plugin,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/pixelbank-plugin",
  "remoteUser": "bun",
  "postCreateCommand": "bun install --frozen-lockfile --ignore-scripts",
  "shutdownAction": "stopContainer"
}
