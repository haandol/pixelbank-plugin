{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pixelbank",
  "version": "0.2.2",
  "description": "Create and reuse PixelbankStudio assets through MCP, with prepared web workspaces for visual editing.",
  "author": {
    "name": "PixelbankStudio",
    "url": "https://www.pixelbankstudio.com"
  },
  "homepage": "https://www.pixelbankstudio.com",
  "repository": "https://github.com/haandol/pixelbank-plugin",
  "keywords": [
    "images",
    "creative-tools",
    "workflows",
    "pixelbank"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "PixelbankStudio",
        "shortDescription": "Images & animation · 이미지·애니메이션",
        "developerName": "PixelbankStudio",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://www.pixelbankstudio.com",
        "defaultPrompt": [
          "Help me create a promotional image with PixelbankStudio.",
          "PixelbankStudio로 홍보용 이미지를 만들어 줘."
        ],
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon-small.png"
      }
    }
  }
}
