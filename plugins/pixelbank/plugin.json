{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pixelbank",
  "version": "0.1.0",
  "description": "Create and reuse Pixelbank assets through MCP, with prepared web workspaces for visual editing.",
  "author": {
    "name": "Pixelbank",
    "url": "https://www.pixelbankstudio.com"
  },
  "homepage": "https://www.pixelbankstudio.com",
  "repository": "https://github.com/haandol/pixelbank-plugin",
  "keywords": [
    "images",
    "creative-tools",
    "workflows",
    "pixelbank"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "Pixelbank",
        "shortDescription": "Creative tools and prepared web workspaces",
        "developerName": "Pixelbank",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://www.pixelbankstudio.com",
        "defaultPrompt": [
          "Help me create a promotional image with Pixelbank."
        ]
      }
    }
  }
}
