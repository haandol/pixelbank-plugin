{
  "name": "pixelbank-creative-plugin",
  "version": "0.2.1",
  "private": true,
  "description": "PixelbankStudio creative workflows through MCP and prepared web workspaces.",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "bun run --bun tsc --noEmit",
    "test": "bun test --timeout 90000 --max-concurrency 1 test/*.test.ts",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "image-size": "2.0.4",
    "jose": "6.2.12",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haandol/pixelbank-plugin.git",
    "directory": "plugins/pixelbank"
  }
}
