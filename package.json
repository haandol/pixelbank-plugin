{
  "name": "pixelbank-plugin-workspace",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/pixelbank"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun run --cwd plugins/pixelbank build",
    "typecheck": "bun run --cwd plugins/pixelbank typecheck",
    "test": "bun run --cwd plugins/pixelbank test",
    "start": "bun run --cwd plugins/pixelbank start",
    "validate": "bun scripts/validate.mjs",
    "check": "bun run typecheck && bun run build && bun run validate && bun run test && bun run test:release",
    "test:release": "bun test scripts/tests/*.test.mjs",
    "check:container": "bash scripts/container-check.sh",
    "hooks:install": "bash scripts/install-hooks.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haandol/pixelbank-plugin.git"
  }
}
