{
  "name": "pixelbank-plugin-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/pixelbank"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build -w plugins/pixelbank",
    "typecheck": "npm run typecheck -w plugins/pixelbank",
    "test": "npm run test -w plugins/pixelbank",
    "start": "npm run start -w plugins/pixelbank",
    "validate": "node scripts/validate.mjs",
    "check": "npm run validate && npm run typecheck && npm run build && npm test && npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haandol/pixelbank-plugin.git"
  }
}
